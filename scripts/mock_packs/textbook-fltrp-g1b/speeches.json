  "title": "Don't do that again",
  "titleZh": "别再这样了",
  "lines": [
   {
    "en": "Dear all, please follow me.",
    "zh": "大家请跟着我。"
   },
   {
    "en": "Don't walk away.",
    "zh": "不要走开。"
   },
   {
    "en": "Oh no. Mum? Mum?",
    "zh": "哎呀。妈妈？妈妈？"
   },
   {
    "en": "Jack is hungry. He is tired, too.",
    "zh": "杰克饿了。他也累了。"
   },
   {
    "en": "Jack is sad. He is scared, too.",
    "zh": "杰克很难过。他也很害怕。"
   },
   {
    "en": "Jack, you are here!",
    "zh": "杰克，你在这儿！"
   },
   {
    "en": "Oh, Mum. I'm so happy.",
    "zh": "哦，妈妈。我太开心了。"
   },
   {
    "en": "I'm happy, too.",
    "zh": "我也很开心。"
   },
   {
    "en": "Don't do that again.",
    "zh": "别再这样了。"
   },
   {
    "en": "Sorry, Mum.",
    "zh": "对不起，妈妈。"
   }
  ],
