  "lines": [
   {
    "en": "Hi. I'm Meimei.",
    "zh": "你好，我是美美。"
   },
   {
    "en": "I'm Beibei.",
    "zh": "我是贝贝。"
   },
   {
    "en": "We are twins.",
    "zh": "我们是双胞胎。"
   },
   {
    "en": "I have big eyes.",
    "zh": "我有一双大眼睛。"
   },
