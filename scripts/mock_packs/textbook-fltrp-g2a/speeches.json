  "book": "二年级上册",
  "bookOrder": 21,
  "group": "Unit 3 Animals",
  "groupZh": "第三单元 动物",
  "title": "Fox and Tiger",
  "titleZh": "狐狸和老虎",
  "lines": [
   {
    "en": "Tiger is hungry.",
    "zh": "老虎饿了。"
   },
   {
    "en": "A fox! Great!",
    "zh": "一只狐狸！太好了！"
   },
   {
    "en": "Don't eat me. I'm the king of animals!",
    "zh": "别吃我。我是百兽之王！"
   },
   {
    "en": "No. I'm the king of animals!",
    "zh": "不，我才是百兽之王！"
   },
   {
    "en": "Let me show you. Come with me.",
    "zh": "我证明给你看。跟我来。"
   },
   {
    "en": "Look! The rabbits run away.",
    "zh": "看！兔子们跑掉了。"
   },
   {
    "en": "The deer runs away, too.",
    "zh": "鹿也跑掉了。"
   },
   {
    "en": "The birds fly away.",
    "zh": "鸟儿们飞走了。"
   },
   {
    "en": "The monkeys run away, too.",
    "zh": "猴子们也跑掉了。"
   },
   {
    "en": "See? I'm the king of animals!",
    "zh": "看到了吧？我是百兽之王！"
   },
   {
    "en": "Yes, you are!",
    "zh": "是的，你是！"
   }
  ],
