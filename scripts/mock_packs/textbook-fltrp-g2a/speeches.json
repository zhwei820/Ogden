    "en": "I have a small nose, too.",
    "zh": "我也有一个小鼻子。"
   },
   {
    "en": "I have a small mouth.",
    "zh": "我有一张小嘴巴。"
   },
   {
    "en": "I have a small mouth, too.",
    "zh": "我也有一张小嘴巴。"
   },
   {
    "en": "People often get us wrong.",
    "zh": "大家常常把我们认错。"
   },
   {
    "en": "What can we do?",
    "zh": "我们能怎么办呢？"
   },
   {
    "en": "I have an idea!",
    "zh": "我有个主意！"
   },
   {
    "en": "I have long hair.",
    "zh": "我留长头发。"
   },
   {
    "en": "I have short hair.",
    "zh": "我留短头发。"
   },
   {
    "en": "We are different now.",
    "zh": "现在我们不一样了。"
   }
